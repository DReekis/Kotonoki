{
  "functions": {
    "api/index.py": {
      "includeFiles": "app/templates/**/*,app/static/**/*"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?_url_path=$1"
    }
  ]
}
